[Unit]
Description=Study Book Finder (Node/Express)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/study-book-finder
EnvironmentFile=/var/www/study-book-finder/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
